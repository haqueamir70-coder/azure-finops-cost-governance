  <diagram id="finops-components-map" name="FinOps Azure Components Map">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#D6E2EF;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1840" height="1230" as="geometry"/></mxCell>
        <mxCell id="title" value="AZURE FINOPS — COMPONENT MAP&#xa;From cost data to governed, measurable optimization" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#12304A;" vertex="1" parent="1"><mxGeometry x="55" y="35" width="1200" height="70" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="REFERENCE DESIGN • Azure service icons/labels • Human approval before production changes • No automatic resource deletion" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#526779;" vertex="1" parent="1"><mxGeometry x="58" y="100" width="1400" height="30" as="geometry"/></mxCell>
        <mxCell id="lane1" value="1  COST DATA SOURCES" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#EAF4FF;swimlaneFillColor=#FFFFFF;strokeColor=#7BB7E8;fontStyle=1;fontSize=17;fontColor=#124A78;" vertex="1" parent="1"><mxGeometry x="50" y="155" width="1780" height="205" as="geometry"/></mxCell>
        <mxCell id="cost" value="💳  Azure Cost Management + Billing&#xa;Usage, actual cost, amortized cost, forecasts&#xa;Scope: billing profile / subscription / resource group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#FFFFFF;fontStyle=1;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="220" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="advisor" value="💡  Azure Advisor&#xa;Rightsizing and idle-resource hints&#xa;Validate utilization, owner, and SLO first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EDFF;strokeColor=#0078D4;fontColor=#12304A;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="455" y="220" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="budgets" value="🔔  Azure Budgets + Action Groups&#xa;Actual / forecast threshold notifications&#xa;Alerts notify; they do not automatically cap spend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D8;strokeColor=#D58A00;fontColor=#674200;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="800" y="220" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="resource" value="🧩  Azure resource inventory&#xa;Subscriptions, resource groups, tags, owners&#xa;Azure Resource Graph can support inventory queries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF5EA;strokeColor=#1A9A6A;fontColor=#104B3A;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="1165" y="220" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="policy" value="🛡️  Azure Policy&#xa;Tag and location standards&#xa;Audit first; enforce only after impact review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE4FF;strokeColor=#7A5AC8;fontColor=#34235E;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="1540" y="220" width="255" height="100" as="geometry"/></mxCell>
        <mxCell id="lane2" value="2  INGESTION, STORAGE &amp; ANALYSIS" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#EAF4FF;swimlaneFillColor=#FFFFFF;strokeColor=#7BB7E8;fontStyle=1;fontSize=17;fontColor=#124A78;" vertex="1" parent="1"><mxGeometry x="50" y="385" width="1780" height="230" as="geometry"/></mxCell>
        <mxCell id="export" value="📤  Cost export&#xa;Scheduled export from Cost Management&#xa;Choose dataset, scope, cadence, and granularity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EDFF;strokeColor=#0078D4;fontColor=#12304A;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="80" y="455" width="275" height="100" as="geometry"/></mxCell>
        <mxCell id="storage" value="🗄️  Storage Account / Data Lake&#xa;Raw export landing zone&#xa;Encryption, RBAC, retention, access logging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EDFF;strokeColor=#0078D4;fontColor=#12304A;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="390" y="455" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="python" value="🐍  Python analyzer (this repo)&#xa;Validate JSON → normalize → aggregate&#xa;Budget status + service / owner breakdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE4FF;strokeColor=#7A5AC8;fontColor=#34235E;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="725" y="455" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="analytics" value="📊  Power BI / Azure Workbooks&#xa;Spend trend, forecast, allocation, unit cost&#xa;Dashboard integration is a target extension" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF5EA;strokeColor=#1A9A6A;fontColor=#104B3A;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="1080" y="455" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="review" value="👥  FinOps review&#xa;Engineering + Finance + Product&#xa;Agree owner, action, risk, expected value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D8;strokeColor=#D58A00;fontColor=#674200;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="1415" y="455" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="lane3" value="3  GOVERNANCE, IDENTITY &amp; DELIVERY" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#EAF4FF;swimlaneFillColor=#FFFFFF;strokeColor=#7BB7E8;fontStyle=1;fontSize=17;fontColor=#124A78;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="1780" height="225" as="geometry"/></mxCell>
        <mxCell id="entra" value="🔐  Microsoft Entra ID + Azure RBAC&#xa;Least privilege; scoped roles; separate duties&#xa;Prefer managed identity / OIDC over long-lived secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3EAF2;strokeColor=#65798C;fontColor=#26394A;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="80" y="710" width="340" height="105" as="geometry"/></mxCell>
        <mxCell id="terraform" value="🏗️  Terraform / Infrastructure as Code&#xa;Budget resources, reusable modules, variables&#xa;Plan reviewed before any apply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE4FF;strokeColor=#7A5AC8;fontColor=#34235E;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="455" y="710" width="330" height="105" as="geometry"/></mxCell>
        <mxCell id="actions" value="⚙️  GitHub Actions CI&#xa;Python tests, Terraform fmt / validate, Checkov&#xa;CI validates code; it does not deploy Azure here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE4FF;strokeColor=#7A5AC8;fontColor=#34235E;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="820" y="710" width="340" height="105" as="geometry"/></mxCell>
        <mxCell id="monitor" value="📈  Azure Monitor + Log Analytics&#xa;Operational signals and diagnostic logs&#xa;Control ingestion volume and retention cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF5EA;strokeColor=#1A9A6A;fontColor=#104B3A;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="1195" y="710" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="alerts" value="📨  Action Groups / owner notifications&#xa;Route alerts to accountable teams&#xa;Track acknowledgement and remediation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D8;strokeColor=#D58A00;fontColor=#674200;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="1530" y="710" width="265" height="105" as="geometry"/></mxCell>
        <mxCell id="lane4" value="4  OPTIMIZATION LOOP — MEASURE BEFORE &amp; AFTER" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#EAF4FF;swimlaneFillColor=#FFFFFF;strokeColor=#7BB7E8;fontStyle=1;fontSize=17;fontColor=#124A78;" vertex="1" parent="1"><mxGeometry x="50" y="890" width="1780" height="255" as="geometry"/></mxCell>
        <mxCell id="rank" value="1. Prioritize&#xa;Rank by spend, business value, confidence, effort, risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7893A8;fontColor=#12304A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="965" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="change" value="2. Change safely&#xa;Right-size, schedule non-prod, tune storage, review commitments&#xa;Owner + change window + rollback plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7893A8;fontColor=#12304A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="415" y="965" width="390" height="90" as="geometry"/></mxCell>
        <mxCell id="verify" value="3. Verify outcomes&#xa;Compare like-for-like usage and billing periods&#xa;Account for growth, credits, reservations, and seasonality" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7893A8;fontColor=#12304A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="840" y="965" width="390" height="90" as="geometry"/></mxCell>
        <mxCell id="backlog" value="4. Record and repeat&#xa;Document owner, evidence, realized savings, SLO impact&#xa;Feed results into next FinOps iteration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF5EA;strokeColor=#1A9A6A;fontColor=#104B3A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1265" y="965" width="530" height="90" as="geometry"/></mxCell>
        <mxCell id="e1" value="Export" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0078D4;fontSize=12;" edge="1" parent="1" source="cost" target="export"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Scheduled files" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0078D4;fontSize=12;" edge="1" parent="1" source="export" target="storage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Read dataset" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7A5AC8;fontSize=12;" edge="1" parent="1" source="storage" target="python"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Report" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#1A9A6A;fontSize=12;" edge="1" parent="1" source="python" target="analytics"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D58A00;fontSize=12;" edge="1" parent="1" source="analytics" target="review"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Guardrails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7A5AC8;fontSize=12;" edge="1" parent="1" source="terraform" target="actions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Secure access" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#65798C;fontSize=12;" edge="1" parent="1" source="entra" target="storage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Signals" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#1A9A6A;fontSize=12;" edge="1" parent="1" source="monitor" target="analytics"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Approved work" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#1A9A6A;fontSize=12;" edge="1" parent="1" source="review" target="rank"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Iterate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#1A9A6A;fontSize=12;" edge="1" parent="1" source="backlog" target="cost"><mxGeometry relative="1" as="geometry"><mxPoint x="1760" y="1180" as="sourcePoint"/><mxPoint x="250" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="note" value="IMPLEMENTATION STATUS: the repository currently analyzes local synthetic JSON. Azure Cost Export ingestion, live Azure queries, Power BI dashboards, and Action Group delivery are design targets—not deployed integrations. The CI pipeline tests Python and validates/scans Terraform; it does not apply infrastructure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#D58A00;fontColor=#674200;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="1165" width="1715" height="60" as="geometry"/></mxCell>
